{
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/projects",
      "destination": "/projects/index.html"
    },
    {
      "source": "/projects/:slug([^./]+)",
      "destination": "/projects/:slug.html"
    },
    {
      "source": "/information",
      "destination": "/information.html"
    }
  ]
}